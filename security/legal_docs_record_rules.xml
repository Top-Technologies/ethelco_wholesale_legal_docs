<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Document types: multi-company -->
        <record id="rule_legal_document_type_company" model="ir.rule">
            <field name="name">Legal Document Type: multi-company</field>
            <field name="model_id" ref="model_ethelco_legal_document_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Partner legal documents: multi-company via partner company -->
        <record id="rule_partner_legal_document_company" model="ir.rule">
            <field name="name">Partner Legal Document: multi-company</field>
            <field name="model_id" ref="model_ethelco_partner_legal_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Sales users: read-only partner docs for their accessible partners -->
        <record id="rule_partner_legal_document_sale_read" model="ir.rule">
            <field name="name">Partner Legal Document: sales read</field>
            <field name="model_id" ref="model_ethelco_partner_legal_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
