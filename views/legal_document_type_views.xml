<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legal_document_type_list" model="ir.ui.view">
        <field name="name">ethelco.legal.document.type.list</field>
        <field name="model">ethelco.legal.document.type</field>
        <field name="arch" type="xml">
            <list string="Legal Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="required_for_wholesale"/>
                <field name="has_expiry"/>
                <field name="warning_days"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_legal_document_type_form" model="ir.ui.view">
        <field name="name">ethelco.legal.document.type.form</field>
        <field name="model">ethelco.legal.document.type</field>
        <field name="arch" type="xml">
            <form string="Legal Document Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Trade License"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="required_for_wholesale"/>
                            <field name="has_expiry"/>
                            <field name="warning_days" invisible="not has_expiry"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_legal_document_type_search" model="ir.ui.view">
        <field name="name">ethelco.legal.document.type.search</field>
        <field name="model">ethelco.legal.document.type</field>
        <field name="arch" type="xml">
            <search string="Legal Document Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Required for Wholesale" name="required_wholesale" domain="[('required_for_wholesale', '=', True)]"/>
                <filter string="Has Expiry" name="has_expiry" domain="[('has_expiry', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_document_type" model="ir.actions.act_window">
        <field name="name">Legal Document Types</field>
        <field name="res_model">ethelco.legal.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_legal_document_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a legal document type required for wholesale customers.
            </p>
        </field>
    </record>
</odoo>
