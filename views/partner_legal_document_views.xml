<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_legal_document_list" model="ir.ui.view">
        <field name="name">ethelco.partner.legal.document.list</field>
        <field name="model">ethelco.partner.legal.document</field>
        <field name="arch" type="xml">
            <list string="Partner Legal Documents"
                  decoration-danger="state in ('missing', 'expired')"
                  decoration-warning="state == 'expiring'"
                  decoration-success="state == 'valid'">
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="document_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="verified"/>
                <field name="state" widget="badge"
                         decoration-danger="state in ('missing', 'expired')"
                         decoration-warning="state == 'expiring'"
                         decoration-success="state == 'valid'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_partner_legal_document_form" model="ir.ui.view">
        <field name="name">ethelco.partner.legal.document.form</field>
        <field name="model">ethelco.partner.legal.document</field>
        <field name="arch" type="xml">
            <form string="Partner Legal Document">
                <header>
                    <button name="action_mark_verified"
                            type="object"
                            string="Mark Verified"
                            class="btn-primary"
                            invisible="verified"
                            groups="ethelco_wholesale_legal_docs.group_legal_compliance_manager"/>
                    <field name="state" widget="badge"
                            decoration-danger="state in ('missing', 'expired')"
                            decoration-warning="state == 'expiring'"
                            decoration-success="state == 'valid'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="type_id"/>
                            <field name="document_number"/>
                            <field name="active" invisible="1"/>
                            <field name="has_expiry" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date" required="has_expiry"/>
                            <field name="verified"
                                     groups="ethelco_wholesale_legal_docs.group_legal_compliance_manager"/>
                            <field name="verified_by"
                                     groups="ethelco_wholesale_legal_docs.group_legal_compliance_manager"/>
                            <field name="verified_date"
                                     groups="ethelco_wholesale_legal_docs.group_legal_compliance_manager"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" colspan="2" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_partner_legal_document_search" model="ir.ui.view">
        <field name="name">ethelco.partner.legal.document.search</field>
        <field name="model">ethelco.partner.legal.document</field>
        <field name="arch" type="xml">
            <search string="Partner Legal Documents">
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="document_number"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Expiring" name="expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Missing / Incomplete" name="missing" domain="[('state', '=', 'missing')]"/>
                <filter string="Unverified" name="unverified" domain="[('verified', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_legal_document" model="ir.actions.act_window">
        <field name="name">Partner Legal Documents</field>
        <field name="res_model">ethelco.partner.legal.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_partner_legal_document_search"/>
    </record>
</odoo>
